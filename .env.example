# Create a NEW token with @BotFather. Never reuse a token posted in chat.
TELEGRAM_BOT_TOKEN=replace-me
# Numeric Telegram user IDs, comma-separated. Empty means nobody is allowed.
TELEGRAM_ALLOWED_USERS=123456789

# OpenAI-compatible model API. SambaNova and other compatible providers can be used.
AI_API_KEY=replace-me
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1
AI_MAX_STEPS=30

# Fine-grained PAT or GitHub App installation token with Contents and Pull requests access.
GITHUB_TOKEN=replace-me
# Restrict the bot to these owners or exact owner/repository values. Required in production.
GITHUB_REPOSITORY_ALLOWLIST=your-github-login,your-org/example-private-repo
GITHUB_CREATE_PR=true

DATA_DIR=./data
MAX_CONCURRENT_TASKS=1
TASK_TIMEOUT_SECONDS=3600
COMMAND_TIMEOUT_SECONDS=600
MAX_TELEGRAM_ARTIFACT_MB=45

# docker is strongly recommended. local executes AI commands directly on the host.
SANDBOX_MODE=docker
SANDBOX_IMAGE=ghcr.io/cirruslabs/flutter:stable
SANDBOX_MEMORY=4g
SANDBOX_CPUS=2
# "none" prevents dependency downloads and private-code exfiltration. Use bridge only for trusted repos.
SANDBOX_NETWORK=none
LOG_LEVEL=INFO
